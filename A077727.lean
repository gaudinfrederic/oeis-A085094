/-- Certificat de la table : pour n dans [10,500), n != 11,
    `wit727 n` est multiple de n de somme de chiffres n-sigma(n). -/
theorem wit727_spec (n : ℕ) (hn10 : 10 ≤ n) (hn500 : n < 500)
    (h11 : n ≠ 11) :
    n ∣ wit727 n ∧ sigma10 (wit727 n) + sigma10 n = n := by
  interval_cases n <;> first
    | exact absurd rfl h11 | native_decide

/-- Assemblage N = c + 10^(len c) * n = concat(n, c) :
    chiffres, somme, divisibilite, suffixe. -/
theorem existsN_of_c {n c : ℕ} (hn : 0 < n)
    (hd : n ∣ c) (hs : sigma10 c + sigma10 n = n) :
    ∃ N : ℕ, 0 < N ∧ n ∣ N ∧ (Nat.digits 10 N).sum = n ∧
      Nat.digits 10 n <:+ Nat.digits 10 N := by
  refine ⟨c + 10 ^ (Nat.digits 10 c).length * n, ?_, ?_, ?_, ?_⟩
  · have hX : 0 < 10 ^ (Nat.digits 10 c).length * n :=
      Nat.mul_pos (Nat.pow_pos (by norm_num)) hn
    omega
  · exact dvd_add hd (dvd_mul_left n _)
  · have h := Nat.digits_append_zeroes_append_digits (b := 10)
      (k := 0) (m := n) (n := c) (by norm_num) hn
    simp only [List.replicate_zero, List.append_nil,
      add_zero] at h
    rw [h.symm, List.sum_append]
    exact hs
  · have h := Nat.digits_append_zeroes_append_digits (b := 10)
      (k := 0) (m := n) (n := c) (by norm_num) hn
    simp only [List.replicate_zero, List.append_nil,
      add_zero] at h
    exact ⟨Nat.digits 10 c, h⟩

/-- La paire [1,1] ajoutee en queue ne change pas la somme
    alternee (contribution 1-1 = 0). -/
theorem altSum_snoc11 (l : List ℕ) :
    ((l.map fun (e : ℕ) => (e : ℤ)) ++ [(1 : ℤ), 1]).alternatingSum =
      (l.map fun (e : ℕ) => (e : ℤ)).alternatingSum := by
  induction l using List.twoStepInduction with
  | nil => simp [List.alternatingSum]
  | singleton a => simp [List.alternatingSum, sub_eq_add_neg]
  | cons_cons a b l ih =>
    show (((a : ℤ) :: (b : ℤ) :: (l.map fun (e : ℕ) => (e : ℤ))) ++
        [(1 : ℤ), 1]).alternatingSum =
      (((a : ℤ) :: (b : ℤ) :: (l.map fun (e : ℕ) => (e : ℤ)))).alternatingSum
    rw [List.cons_append, List.cons_append, alternatingSum_cons,
      alternatingSum_cons, ih, alternatingSum_cons, alternatingSum_cons]

/-- Budget : pour n >= 500, n - 9*len(n) >= 15*(n/27+1)+20. -/
theorem budget727 (n : ℕ) (hn : 500 ≤ n) :
    15 * (n / 27 + 1) + 20 ≤
      n - 9 * (Nat.digits 10 n).length := by
  have hlog : Nat.log 10 n ≤ n / 125 := log10_le_125 n hn
  have hlen : (Nat.digits 10 n).length = Nat.log 10 n + 1 :=
    Nat.length_digits 10 n (by norm_num) (by omega)
  omega

/-- Existence du bloc c pour n >= 500 : n | c et
    sigma(c) = n - sigma(n). Chemin : n = 2^a*5^b*m,
    cm multiple de m de somme s (L3d), c = cm*10^max a b. -/
theorem middle727 (n : ℕ) (hn : 500 ≤ n) :
    ∃ c : ℕ, n ∣ c ∧ sigma10 c + sigma10 n = n := by
  set a := padicValNat 2 n
  set q1 := Nat.divMaxPow n 2
  set b := padicValNat 5 q1
  set m := Nat.divMaxPow q1 5
  have hn0 : n ≠ 0 := by omega
  have hq1 : q1 * 2 ^ a = n := Nat.divMaxPow_mul_pow_padicValNat 2 n
  have hmq : m * 5 ^ b = q1 := Nat.divMaxPow_mul_pow_padicValNat 5 q1
  have hq10 : q1 ≠ 0 := by
    intro h; rw [h, zero_mul] at hq1; exact hn0 hq1.symm
  have hdecomp : n = 2 ^ a * 5 ^ b * m := by
    rw [← hmq] at hq1; rw [← hq1]; ring
  have h2q1 : ¬ 2 ∣ q1 := Nat.not_dvd_divMaxPow (by norm_num) hn0
  have h5m : ¬ 5 ∣ m := Nat.not_dvd_divMaxPow (by norm_num) hq10
  have hmq1 : m ∣ q1 := ⟨5 ^ b, hmq.symm⟩
  have h2m : ¬ 2 ∣ m := fun h => h2q1 (h.trans hmq1)
  have h2 : Nat.Coprime m 2 :=
    ((Nat.prime_two.coprime_iff_not_dvd).mpr h2m).symm
  have h5 : Nat.Coprime m 5 :=
    ((Nat.prime_five.coprime_iff_not_dvd).mpr h5m).symm
  have hc10 : Nat.Coprime m 10 := by
    have hc : Nat.Coprime m (2 * 5) := Nat.Coprime.mul_right h2 h5
    rwa [show (2 : ℕ) * 5 = 10 from rfl] at hc
  have hmn : m ≤ n := by
    have hdmn : m ∣ n := ⟨2 ^ a * 5 ^ b, by rw [hdecomp]; ring⟩
    exact Nat.le_of_dvd (by omega) hdmn
  have hm0 : m ≠ 0 := by
    intro hmz; rw [hmz, zero_mul] at hmq; exact hq10 hmq.symm
  have hgs : Nat.gcd 9 m ∣ n - sigma10 n := by
    have hσle : sigma10 n ≤ n := by
      have hb := budget727 n hn
      have hle := sigma10_le_9len n
      omega
    have h9d : 9 ∣ n - sigma10 n :=
      (Nat.modEq_iff_dvd' hσle).mp (Nat.modEq_nine_digits_sum n).symm
    exact (Nat.gcd_dvd_left 9 m).trans h9d
  have hbig : 15 * (m / 27 + 1) + 20 ≤ n - sigma10 n := by
    have hb := budget727 n hn
    have hσle : sigma10 n ≤ 9 * (Nat.digits 10 n).length :=
      sigma10_le_9len n
    have hdiv27 : m / 27 ≤ n / 27 := Nat.div_le_div_right hmn
    omega
  obtain ⟨cm, hcm, hcmσ⟩ := L3d m (n - sigma10 n) (by omega)
    hc10 hgs hbig
  have hcmpos : 0 < cm := by
    rcases Nat.eq_zero_or_pos cm with h | h
    · exfalso
      rw [h] at hcmσ; simp at hcmσ
      omega
    · exact h
  refine ⟨cm * 10 ^ max a b, ?_, ?_⟩
  · rw [hdecomp]
    have h2a : 2 ^ a ∣ 10 ^ max a b := by
      rw [show (10 : ℕ) = 2 * 5 from rfl, Nat.mul_pow]
      exact dvd_mul_of_dvd_left
        (pow_dvd_pow 2 (le_max_left a b)) _
    have h5b : 5 ^ b ∣ 10 ^ max a b := by
      rw [show (10 : ℕ) = 2 * 5 from rfl, Nat.mul_pow]
      exact dvd_mul_of_dvd_right
        (pow_dvd_pow 5 (le_max_right a b)) _
    have hc25 : Nat.Coprime (2 ^ a) (5 ^ b) :=
      Nat.Coprime.pow_right b
        (Nat.Coprime.pow_left a (by norm_num))
    have h25 : 2 ^ a * 5 ^ b ∣ cm * 10 ^ max a b :=
      hc25.mul_dvd_of_dvd_of_dvd
        (dvd_mul_of_dvd_right h2a cm)
        (dvd_mul_of_dvd_right h5b cm)
    have hcR : Nat.Coprime (2 ^ a * 5 ^ b) m :=
      (Nat.Coprime.mul_right (Nat.Coprime.pow_right a h2)
        (Nat.Coprime.pow_right b h5)).symm
    exact hcR.mul_dvd_of_dvd_of_dvd h25 (dvd_mul_of_dvd_left hcm _)
  · have hσ : sigma10 (cm * 10 ^ max a b) = sigma10 cm := by
      rw [sigma10, mul_comm cm (10 ^ max a b),
        Nat.digits_base_pow_mul (by norm_num) hcmpos,
        List.sum_append, List.sum_replicate, smul_eq_mul,

/-- A077727 : existe N commencant par n, somme de chiffres n,
    multiple de n, ssi n != 11. -/
theorem A077727 (n : ℕ) (hn : 1 ≤ n) :
    (∃ N : ℕ, 0 < N ∧ n ∣ N ∧ (Nat.digits 10 N).sum = n ∧
      Nat.digits 10 n <:+ Nat.digits 10 N) ↔ n ≠ 11 := by
  constructor
  · rintro ⟨N, hN0, hdv, hsum, hsuf⟩ h11
    subst h11
    have hdn : Nat.digits 10 11 = [1, 1] := by decide
    rw [hdn] at hsuf
    obtain ⟨a, ha⟩ := hsuf
    have hσa : a.sum = 9 := by
      have hs2 : (Nat.digits 10 N).sum = a.sum + 2 := by
        rw [← ha, List.sum_append]; simp
      omega
    have h11d : (11 : ℤ) ∣
        ((Nat.digits 10 N).map fun (e : ℕ) => (e : ℤ)).alternatingSum :=
      Nat.eleven_dvd_iff.mp hdv
    rw [← ha, List.map_append] at h11d
    simp only [List.map_cons, List.map_nil, Nat.cast_one] at h11d
    rw [altSum_snoc11] at h11d
    obtain ⟨k, hk⟩ := h11d
    have habs := altSum_abs_le a
    rw [hσa] at habs
    have hk0 : k = 0 := by
      rw [hk] at habs
      have h2 := abs_le.mp habs
      omega
    rw [hk0] at hk; simp at hk
    have hpar := altSum_modEq_two a
    rw [hσa, hk] at hpar
    exact absurd hpar (by decide)
  · intro hne
    rcases lt_or_ge n 10 with h10 | h10
    · refine ⟨n, hn, dvd_refl n, ?_, ?_⟩
      · interval_cases n <;> decide
      · exact ⟨[], by simp⟩
    · rcases lt_or_ge n 500 with h5 | h5
      · exact existsN_of_c hn (wit727_spec n h10 h5 hne).1
          (wit727_spec n h10 h5 hne).2
      · obtain ⟨c, hd, hs⟩ := middle727 n h5
        exact existsN_of_c hn hd hs
